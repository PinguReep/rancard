{
  "expo": {
    "name": "Rencar",
    "slug": "atelier",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rencar",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.example.rencar",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "Rencar",
        "NSCameraUsageDescription": "Pour photographier le véhicule et l'ajouter au suivi du client.",
        "NSPhotoLibraryUsageDescription": "Pour joindre une photo ou une vidéo du véhicule au suivi du client.",
        "NSMicrophoneUsageDescription": "Pour enregistrer une vidéo du véhicule avec le son.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.example.rencar",
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0b0e",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2f6bff",
          "defaultChannel": "rencar"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour joindre une photo ou une vidéo du véhicule au suivi du client.",
          "cameraPermission": "Pour photographier le véhicule et l'ajouter au suivi du client."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
