{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_VARIANT": "test",
        "EXPO_PUBLIC_BACKEND": "demo"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_VARIANT": "test",
        "EXPO_PUBLIC_BACKEND": "demo"
      }
    },
    "testflight": {
      "distribution": "store",
      "channel": "testflight",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "test"
      }
    },
    "preprod": {
      "distribution": "store",
      "channel": "preprod",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "test",
        "EXPO_PUBLIC_BACKEND": "supabase"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_BACKEND": "supabase"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {}
    },
    "preprod": {
      "ios": {}
    },
    "production": {
      "ios": {}
    }
  }
}
