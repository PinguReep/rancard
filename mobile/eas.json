{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_BACKEND": "demo"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_BACKEND": "demo"
      }
    },
    "testflight": {
      "distribution": "store",
      "channel": "testflight",
      "autoIncrement": true
    }
  },
  "submit": {
    "testflight": {
      "ios": {}
    }
  }
}
