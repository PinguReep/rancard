# Backend de données : "demo" (données locales sur le téléphone) ou "supabase"
EXPO_PUBLIC_BACKEND=demo
# Renseigner pour EXPO_PUBLIC_BACKEND=supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Le bouton « garage de démonstration » ouvre toujours la démo locale (données
# sur le téléphone), même en mode supabase : aucun compte de démonstration ni
# mot de passe dans l'app. Toute variable EXPO_PUBLIC_* est lisible dans le build.
# Page « suivi de mon véhicule » : base de l'adresse, sans « ?t= » (l'app ajoute ?t=<jeton>).
# Même valeur que SUIVI_URL_BASE de la fonction Edge sms, par exemple
# https://<projet>.supabase.co/functions/v1/suivi ou le domaine qui la sert.
EXPO_PUBLIC_SUIVI_URL=https://suivi.rencar.example/suivi

# Builds EAS et EAS Update seulement (lus par app.config.ts). En CI, ce sont
# des secrets GitHub ; en local, à renseigner ici pour lancer eas build.
EXPO_OWNER=
EAS_PROJECT_ID=
APP_BUNDLE_ID=com.example.rencar
