# Backend de données : "demo" (données locales sur le téléphone) ou "supabase"
EXPO_PUBLIC_BACKEND=demo
# Renseigner pour EXPO_PUBLIC_BACKEND=supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Le bouton « garage de démonstration » ouvre toujours la démo locale (données
# sur le téléphone), même en mode supabase : aucun compte de démonstration ni
# mot de passe dans l'app. Toute variable EXPO_PUBLIC_* est lisible dans le build.
# Page « suivi de mon véhicule » : base de l'adresse, sans « ?t= » (l'app ajoute ?t=<jeton>).
# Même valeur que SUIVI_URL_BASE de la fonction Edge sms, par exemple
# https://<projet>.supabase.co/functions/v1/suivi ou le domaine qui la sert.
EXPO_PUBLIC_SUIVI_URL=https://suivi.rencar.fr/suivi
# Vérification anti-robot de « Créer un compte » (Cloudflare Turnstile) : clé de site du widget,
# PUBLIQUE (tableau de bord Cloudflare → Turnstile ; jamais la clé secrète, qui ne va que dans
# TURNSTILE_SECRET de la fonction inscription). Le contrôle de publication l'exige en production,
# la signale absente en preprod, et refuse partout une clé secrète ou une clé de test.
# Sans clé, ou en démonstration (EXPO_PUBLIC_BACKEND=demo) : aucun widget, aucun jeton envoyé ;
# la fonction l'accepte tant que TURNSTILE_SECRET n'est pas posé, puis répond « Mettez à jour l'app ».
# Clés de test officielles de Cloudflare, pour essayer l'écran en local seulement (tout domaine) :
#   1x00000000000000000000AA  toujours valide
#   2x00000000000000000000AB  toujours refusée (le widget signale une erreur)
#   3x00000000000000000000FF  interaction forcée (la case à cocher apparaît)
# La fonction inscription n'accepte les clés secrètes de test que sur un projet local (supabase start) :
# en ligne, elle répond 503 à toute inscription.
EXPO_PUBLIC_TURNSTILE_SITEKEY=
# App à essayer ou à construire (app.config.ts, react-native.config.js) : « production » (Rencar,
# App Store, sans la sonnerie VoIP ; valeur par défaut) ou « test » (Rencar Test, TestFlight, avec
# la sonnerie). Les builds EAS la reçoivent de leur profil (eas.json), les mises à jour de
# l'environnement EAS ; ici, seulement pour voir la sonnerie simulée en local (npm run web).
# APP_VARIANT=test

# Builds EAS et EAS Update seulement (lus par app.config.ts). En CI, ce sont
# des secrets GitHub ; en local, à renseigner ici pour lancer eas build.
EXPO_OWNER=
EAS_PROJECT_ID=
APP_BUNDLE_ID=com.example.rencar
